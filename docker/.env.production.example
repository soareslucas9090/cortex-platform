# Copie para .env.production e substitua os valores marcados como "troque".
# ALLOWED_HOSTS no compose ganha ,127.0.0.1 automaticamente para o healthcheck interno.
# CORTEX_DOMAIN vazio ou _ deixa o Nginx só em HTTP (sem certificado).
# Não publique este arquivo preenchido com segredos reais.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-aleatoria
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.seudominio.com
CSRF_TRUSTED_ORIGINS=https://api.seudominio.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ORIGIN_WHITELIST=https://app.seudominio.com
SIMPLE_JWT_SIGNING_KEY=troque-por-outra-chave-longa-aleatoria

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=cortex
DATABASE_USER=cortex
DATABASE_PASSWORD=troque-por-uma-senha-forte
DATABASE_HOST=db
DATABASE_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=4
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60

CORTEX_DOMAIN=api.seudominio.com
LETSENCRYPT_EMAIL=admin@seudominio.com
CORTEX_PUBLIC_BASE_URL=https://api.seudominio.com

AWS_S3_ENDPOINT_URL=https://t3.storage.box
AWS_STORAGE_BUCKET_NAME=organized-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
