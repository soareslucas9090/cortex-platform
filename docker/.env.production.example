# Copie para docker/.env.docker NA VPS. Não commite o arquivo copiado.
# cp docker/.env.production.example docker/.env.docker
#
# A senha do Postgres daqui é NOVA. Não é a senha do banco da Railway.
# DJANGO_SECRET_KEY, JWT, e-mail e S3: copie os mesmos valores das Variables da Railway
# se quiser manter tokens e arquivos já gravados.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-aleatoria
DJANGO_DEBUG=False
DJANGO_BEHIND_PROXY=True
SIMPLE_JWT_SIGNING_KEY=

# Domínio público da API, sem https:// e sem barra.
ALLOWED_HOSTS=api.seudominio.com
CSRF_TRUSTED_ORIGINS=https://api.seudominio.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ORIGIN_WHITELIST=https://app.seudominio.com

# URL que o worker usa quando não há request HTTP.
CORTEX_PUBLIC_BASE_URL=https://api.seudominio.com

# Porta só em 127.0.0.1. O outro projeto da VPS deve usar outra (ex.: 8020).
CORTEX_HTTP_PORT=8010
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=cortex
DATABASE_USER=cortex
DATABASE_PASSWORD=troque-por-uma-senha-forte
DATABASE_HOST=db
DATABASE_PORT=5432

# O container do Postgres lê estes três nomes. Mantenha iguais aos DATABASE_* acima.
POSTGRES_DB=cortex
POSTGRES_USER=cortex
POSTGRES_PASSWORD=troque-por-uma-senha-forte

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=2

DEFAULT_FROM_EMAIL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
